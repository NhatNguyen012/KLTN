    "def defined_attackers(test_path, host, f):\n",
    "    attacks = []\n",
    "    lab = label_df[label_df[\"hostname\"] == host][\"timestamp\"]\n",
    "\n",
    "    l = f.split(\"~\")\n",
    "    start = l[0].replace(\" \", \"T\")\n",
    "    end = l[1].replace(\" \", \"T\").replace(\".txt\", \"\")\n",
    "\n",
    "    for i in lab:\n",
    "        if start <= i <= end:\n",
    "            attacks.append(test_path + f)\n",
    "            break\n",
    "    \n",
    "    return attacks"
   ]
  },
