    "    if '->' in path_name:\n",
    "        if 'outbound' in path_name:\n",
    "            msg=re.findall(\"->(.*?):\",path_name)[0]\n",
    "            return msg\n",
    "        elif 'inbound' in path_name:\n",
    "            msg=re.findall(\"#(.*?):\",path_name)[0]\n",
    "            return msg\n",
    "    return path_name"
