   "source": [
    "replace_dic={\n",
    "    '.pyc':'*.pyc',\n",
    "    '.dll':'*.dll',\n",
    "    '.DLL':'*.DLL',\n",
    "}\n",
    "\n",
    "def replace_path_name(path_name):\n",
    "    for i in replace_dic:\n",
    "        if i in path_name:\n",
    "            return replace_dic[i]\n",
    "    if '->' in path_name:\n",
    "        if 'outbound' in path_name:\n",
    "            msg=re.findall(\"->(.*?):\",path_name)[0]\n",
    "            return msg\n",
    "        elif 'inbound' in path_name:\n",
    "            msg=re.findall(\"#(.*?):\",path_name)[0]\n",
    "            return msg\n",
    "    return path_name"
   ]
