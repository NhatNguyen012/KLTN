    "def analyse_results(pred, label):\n",
    "    TP = []\n",
    "    FN = []\n",
    "    FP = []\n",
    "    for i in label:\n",
    "        if label[i] == pred[i] and pred[i]==1:\n",
    "            TP.append(i)\n",
    "        elif label[i] != pred[i] and pred[i]==1:\n",
    "            FN.append(i)\n",
    "        elif label[i] != pred[i] and pred[i]==0:\n",
    "            FP.append(i)\n",
    "    \n",
    "\n",
    "    print(f\"\\nTP: {TP}\\nFP: {FP}\\nFN: {FN}\\n\")"
   ]
