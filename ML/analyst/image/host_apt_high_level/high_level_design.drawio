        <mxCell id="sources" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Multi-source host logs&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;OS / Security • Application / Service&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Orchestration / Audit where available&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Host-observed communication events&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;No separate network sensor&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8EEF3;strokeColor=#8595A5;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="270" width="560" height="170" />
        </mxCell>
        <mxCell id="collector" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Collector &amp;amp; normalization&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Source adapters • host/process identity • time&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Preserve provenance and availability masks&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Extract bounded, model-compatible features&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="490" width="560" height="140" />
        </mxCell>
        <mxCell id="ml" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Lightweight ML&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:19px&quot;&gt;RF / XGB / LightGBM&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Known-threat score&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Event-level evidence&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="685" width="265" height="140" />
        </mxCell>
        <mxCell id="ood" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:12px&quot;&gt;Novelty / OOD detector&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Unknown / suspicious score&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;Separate calibrated policy&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;Requires development&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="685" width="265" height="140" />
        </mxCell>
        <mxCell id="coordinator" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Agent coordinator&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Benign / known malicious / unknown-suspicious&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Select and forward logs, scores and evidence&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Optional agentic investigation; unknown ≠ malicious&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="885" width="560" height="155" />
        </mxCell>
        <mxCell id="ingest" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Ingestion, correlation &amp;amp; sample building&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Normalize source schemas; correlate host / process / time; retain source provenance&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Construct causal host/process context and ordered event sequences&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Window length and prediction target are explicit configuration; align evidence availability&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#DDF0E5;strokeColor=#4C9070;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="270" width="1500" height="140" />
        </mxCell>
        <mxCell id="graph" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Host / process provenance branch&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Causal graph construction → learned GraphSAGE&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Host ML score + graph context / cascade&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Evidence from observed events only&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Map event-level output to the shared target&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8E3FC;strokeColor=#7D71B4;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="490" width="690" height="170" />
        </mxCell>
        <mxCell id="temporal" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Temporal DL branch&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Sequence encoding + masks&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;BiLSTM OR Mixed-Type Self-Attention&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Independently trained alternatives&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Target source adapters require training / validation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8E3FC;strokeColor=#7D71B4;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1605" y="490" width="690" height="170" />
        </mxCell>
        <mxCell id="fusion" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Context-aware fusion&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Align local ML, graph and sequence evidence to a shared host / time target&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Gating / cross-attention + source masks; calibrate on validation&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Produce APT assessment, confidence and supporting evidence&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="745" width="960" height="145" />
        </mxCell>
        <mxCell id="review" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Analyst review &amp;amp; alert management&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Investigate alerts / unknown cases → adjudicated labels and reviewed errors&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="950" width="960" height="100" />
        </mxCell>
        <mxCell id="monitor" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Drift monitor &amp;amp; learning controller&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Trigger: sustained drift OR reviewed decline&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;OR sufficient confirmed new samples&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Apply label / quality / eligibility gates&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Drift alone does not create labels&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90" y="1230" width="495" height="185" />
        </mxCell>
        <mxCell id="train" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Trainer&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:20px&quot;&gt;New verified TRAIN data + replay&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Retrain ML / fine-tune DL as appropriate&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Produce a candidate model&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Keep evaluation partitions held out&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="655" y="1230" width="495" height="185" />
        </mxCell>
        <mxCell id="validate" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Model validator&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Validate old and new domains&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Check detection and false-positive behavior&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Record validation report&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Promote only if policy is satisfied&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1220" y="1230" width="495" height="185" />
        </mxCell>
        <mxCell id="deploy" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Registry &amp;amp; deployment&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Approved version + schema + thresholds&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Roll out to eligible model services&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Monitor behavior after deployment&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;Retain prior version for rollback&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1785" y="1230" width="515" height="185" />
        </mxCell>
        <mxCell id="offline" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Offline research datasets&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:19px&quot;&gt;OpTC + external datasets → adapters / label review&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Curate source-aware TRAIN / validation / TEST&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Additional data requires training to change weights&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8EEF3;strokeColor=#8595A5;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1550" width="620" height="135" />
        </mxCell>
        <mxCell id="storage" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Persistent storage / mounted volume attached to the Central VM&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Raw logs • processed events / sequences • evidence and label provenance&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Verified datasets + replay buffer (trainer / validator) • model versions + metadata (registry)&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Ingestion / analysis / review services read and write their corresponding logical stores&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8EEF3;strokeColor=#8595A5;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="1550" width="1570" height="135" />
        </mxCell>
        <mxCell id="title" value="Multi-source Host APT Detection — High-level Architecture" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=36;fontStyle=1;fontColor=#183047;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="20" width="2250" height="60" />
        </mxCell>
        <mxCell id="subtitle" value="Target design • endpoint monitoring + central contextual analysis + validated model updates" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=0;fontColor=#4E6276;fillColor=none;strokeColor=none;" vertex="1" parent="1">
