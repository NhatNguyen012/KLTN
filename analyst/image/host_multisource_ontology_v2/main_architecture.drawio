        <mxCell id="meta_event" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Telemetry meta-model&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Entity • Record • Source • Relation&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Identity • event time • observation time&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Schema and provenance constraints&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FBE4E3;strokeColor=#BF6368;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="185" width="620" height="150" />
        </mxCell>
        <mxCell id="meta_detection" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Detection meta-model&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Task • Evidence • PredictionTarget • Label&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Prediction ≠ verified ground truth&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Confidence • uncertainty • label provenance&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FBE4E3;strokeColor=#BF6368;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="185" width="620" height="150" />
        </mxCell>
        <mxCell id="meta_ops" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Deployment &amp;amp; learning meta-model&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Host • VM • Container • Service • Agent&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Dataset • TrainingJob • ModelVersion&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Validation • promotion • rollback policy&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FBE4E3;strokeColor=#BF6368;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="185" width="620" height="150" />
        </mxCell>
        <mxCell id="telemetry" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Shared entity &amp;amp; observation ontology&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Host • Process • Resource • LogSource • LogRecord&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;LogRecord observedBy LogSource; Process runsOn Host&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Record hasEventTime / availableAt / sourceProvenance&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#DDF0E5;strokeColor=#4C9070;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="410" width="970" height="155" />
        </mxCell>
        <mxCell id="analysis" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Shared analysis &amp;amp; model-lifecycle ontology&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Prediction aboutTarget / usesModel / supportedBy Evidence&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;GroundTruth hasLabelSet / labelUnit / verifiedBy&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;TrainingJob usesDataset / producesCandidateModel&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#DDF0E5;strokeColor=#4C9070;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="410" width="970" height="155" />
        </mxCell>
        <mxCell id="host_domain" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Host activity ontology&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Process • File • Registry • User • Service&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Process spawns Process; Event targets Resource&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Event performedBy Process / Principal&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;CommunicationEvent associatedWith Host / Process&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Endpoint observations retain their source origin&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8E3FC;strokeColor=#7D71B4;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="655" width="620" height="240" />
        </mxCell>
        <mxCell id="log_domain" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Multi-source log ontology&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;OS / Security • Application / Service • Orchestration&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;These source types are subclasses of LogSource&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;LogRecord describes HostEvent / ServiceEvent&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;LogRecord associatedWithHost; hasSourceSchema&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Adapters map source fields to shared concepts&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8E3FC;strokeColor=#7D71B4;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="655" width="620" height="240" />
        </mxCell>
        <mxCell id="target_domain" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Temporal, prediction &amp;amp; learning ontology&lt;/div&gt;&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;TemporalWindow associatedWithHost&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;EventSequence containsEvent; belongsTo Window&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;PredictionTarget: Event / Sequence / Window&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;TrainingJob uses VerifiedDataset + ReplayBuffer&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;CandidateModel evaluatedBy ValidationReport&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#E8E3FC;strokeColor=#7D71B4;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="655" width="620" height="240" />
        </mxCell>
        <mxCell id="collector" value="&lt;div style=&quot;font-size:22px;font-weight:bold;margin-bottom:12px&quot;&gt;Log collector &amp;amp; source adapters&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:19px&quot;&gt;OS / security, application / service logs&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Orchestration / audit logs when available&lt;/div&gt;&lt;div style=&quot;font-size:16px&quot;&gt;Normalize identity, timestamps and provenance&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="105" y="1080" width="430" height="140" />
        </mxCell>
        <mxCell id="ml" value="&lt;div style=&quot;font-size:21px;font-weight:bold;margin-bottom:12px&quot;&gt;Lightweight ML&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;RF / XGB / LGBM&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Known-threat score&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Evidence references&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="105" y="1250" width="205" height="140" />
        </mxCell>
        <mxCell id="ood" value="&lt;div style=&quot;font-size:23px;font-weight:bold;margin-bottom:12px&quot;&gt;Novelty / OOD&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Unknown / suspicious&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Calibrated policy&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Needs validation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="1250" width="205" height="140" />
        </mxCell>
        <mxCell id="agent" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Agent coordinator&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Benign / known malicious / unknown-suspicious&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;Collect evidence → send logs and scores&lt;/div&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Agentic investigation is an optional extension&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="105" y="1425" width="430" height="150" />
        </mxCell>
        <mxCell id="ingest" value="&lt;div style=&quot;font-size:23px;font-weight:bold;margin-bottom:12px&quot;&gt;Ingestion &amp;amp; contextual analysis&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Source adapters • correlation • graph context&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Host/process GraphSAGE + temporal DL&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;BiLSTM OR Mixed-Type Self-Attention&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="645" y="1080" width="430" height="140" />
        </mxCell>
        <mxCell id="fusion" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;Context-aware fusion&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:17px&quot;&gt;Align prediction targets and available evidence&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;Gating / cross-attention + source masks&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;APT assessment • confidence • explanation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="1080" width="430" height="140" />
        </mxCell>
        <mxCell id="soc" value="&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:12px&quot;&gt;SOC review &amp;amp; evidence&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Investigation • adjudicated labels&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Track false positives / negatives&lt;/div&gt;&lt;div style=&quot;font-size:18px&quot;&gt;Unknown cases → review, not automatic labels&lt;/div&gt;&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;spacing=10;fillColor=#FFF4C8;strokeColor=#B99A40;strokeWidth=2;fontColor=#183047;" vertex="1" parent="1">
