# The defaults already match the OpenStack AIO environment documented in
# OpenStack_2026.1_Ubuntu_24.04.md and verified on 2026-10-27.
external_network_name = "public-net"
ubuntu_image_name     = "Ubuntu-24.04"
windows_image_name    = "Windows-11-Enterprise-LTSC-2024"
ubuntu_flavor_name    = "m1.small"
keypair_name          = "lab-key"

# lab-key already exists, so Terraform should only reference it.
create_keypair      = false
ssh_public_key_path = "~/.ssh/openstack_ed25519.pub"

# This is convenient for the isolated AIO lab. Restrict it to your management
# source CIDR before using the configuration in a shared environment.
ssh_source_cidr = "172.31.250.1/32"
rdp_source_cidr = "172.31.250.1/32"

create_floating_ips = true

# Uncomment and edit this whole map to change names or address ranges.
