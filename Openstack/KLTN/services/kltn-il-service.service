[Unit]
Description=KLTN Incremental Learning service (approval-gated training requests -> candidate bundles in MLflow)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nguyen
Group=nguyen
WorkingDirectory=/mnt/SSD_Data/optc/Openstack/KLTN
Environment=PYTHONUNBUFFERED=1
Environment=KLTN_SECRETS=/mnt/SSD_Data/optc/Openstack/KLTN/runtime/secrets.json
ExecStart=/mnt/SSD_Data/optc/Openstack/KLTN/runtime/il-venv/bin/python scripts/il_service.py --daemon
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
