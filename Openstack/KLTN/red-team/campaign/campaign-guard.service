# Host (openstack-aio): the ROE auto-stop guard. Install to /etc/systemd/system/, then:
#   systemctl enable --now kltn-campaign-guard
[Unit]
Description=KLTN campaign guard (ROE auto-stop: pause attacker on host pressure)
[Service]
Type=simple
Environment=MIN_MB=4096 MIN_SWAP_FREE_MB=512 INTERVAL=60
ExecStart=/bin/bash /mnt/SSD_Data/optc/Openstack/KLTN/red-team/campaign/campaign_guard.sh
Restart=on-failure
RestartSec=20
[Install]
WantedBy=multi-user.target
