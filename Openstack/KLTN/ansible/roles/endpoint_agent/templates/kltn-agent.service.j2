[Unit]
Description=KLTN model-free endpoint inbox and ML runtime
After=network.target

[Service]
User=kltn-agent
Group=kltn-agent
WorkingDirectory=/opt/kltn-agent
Environment=KLTN_AGENT_CONFIG=/etc/kltn-agent/config.json
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kltn-agent/venv/bin/python -m uvicorn agent:app --host 127.0.0.1 --port 18081 --no-access-log --limit-concurrency 8 --timeout-keep-alive 5
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kltn-agent
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
